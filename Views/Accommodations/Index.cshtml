@model IEnumerable<ErasmusMate.Models.Accommodation>

@{
    ViewData["Title"] = "Accommodation Board";
}

<div class="container mt-4">
    <h2>🏠 Accommodation Board</h2>
    <p class="text-muted">Find or share rooms, dorms, and flats in the area.</p>

    <div class="card mb-4 shadow-sm bg-light border-0">
        <div class="card-body">
            <h5 class="card-title mb-3">Post a New Listing</h5>
            <form asp-controller="Accommodations" asp-action="Add" method="post" class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold">Title</label>
                    <input type="text" name="title" class="form-control" placeholder="e.g. Single room near campus" required>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">Price (€)</label>
                    <input type="number" step="0.01" name="price" class="form-control" placeholder="e.g. 200" required>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-bold">Location</label>
                    <input type="text" name="location" class="form-control" placeholder="e.g. Čakovec Center" required>
                </div>
                <div class="col-md-8">
                    <label class="form-label fw-bold">Description</label>
                    <input type="text" name="description" class="form-control" placeholder="Brief details about the place...">
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold">Contact Info</label>
                    <input type="text" name="contactInfo" class="form-control" placeholder="Email or Phone">
                </div>
                <div class="col-12 text-end">
                    <button type="submit" class="btn btn-success px-4">Post Listing</button>
                </div>
            </form>
        </div>
    </div>

    <div class="row row-cols-1 row-cols-md-3 g-4">
        @foreach (var item in Model)
        {
            <div class="col">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body">
                        <h5 class="card-title text-primary fw-bold">@item.Title</h5>
                        <h6 class="card-subtitle mb-3 text-muted">📍 @item.Location</h6>
                        <p class="card-text">@item.Description</p>
                        <p class="card-text fs-5 text-success mb-1"><strong>@item.Price € </strong><span class="fs-6 text-muted">/ month</span></p>
                        <p class="card-text"><small class="text-muted">✉️ Contact: @item.ContactInfo</small></p>
                    </div>
                    <div class="card-footer bg-white border-top-0 text-end">
                        <form asp-controller="Accommodations" asp-action="Delete" asp-route-id="@item.Id" method="post">
                            <button type="submit" class="btn btn-sm btn-outline-danger">Delete</button>
                        </form>
                    </div>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-secondary mt-3 text-center">No accommodations posted yet. Be the first to share!</div>
    }
</div>