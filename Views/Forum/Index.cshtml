@model IEnumerable<ErasmusMate.Models.ForumPost>

@{
    ViewData["Title"] = "Community Forum";
}

<div class="container mt-4">
    <h2>💬 Community Forum (Q&A)</h2>
    <p class="text-muted">Ask questions, share travel tips, and connect with other students.</p>

    <div class="card mb-4 shadow-sm border-primary">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Ask a New Question</h5>
        </div>
        <div class="card-body">
            <form asp-controller="Forum" asp-action="AddPost" method="post" class="row g-3">
                <div class="col-md-4">
                    <label class="form-label fw-bold">Your Name (Optional)</label>
                    <input type="text" name="author" class="form-control" placeholder="Leave blank to post anonymously">
                </div>
                <div class="col-md-8">
                    <label class="form-label fw-bold">Topic Title</label>
                    <input type="text" name="title" class="form-control" placeholder="e.g. Best local markets in the area?" required>
                </div>
                <div class="col-12">
                    <label class="form-label fw-bold">Question Details</label>
                    <textarea name="content" class="form-control" rows="3" placeholder="Explain what you need help with..." required></textarea>
                </div>
                <div class="col-12 text-end">
                    <button type="submit" class="btn btn-primary px-4">Post Question</button>
                </div>
            </form>
        </div>
    </div>

    <div class="list-group shadow-sm">
        @foreach (var item in Model)
        {
            <div class="list-group-item list-group-item-action flex-column align-items-start">
                <div class="d-flex w-100 justify-content-between mb-2">
                    <h5 class="mb-1 text-dark fw-bold">@item.Title</h5>
                    <small class="text-muted">@item.CreatedAt.ToString("MMM dd, yyyy - HH:mm")</small>
                </div>
                <p class="mb-1 text-secondary">@item.Content</p>
                <div class="d-flex justify-content-between align-items-center mt-3">
                    <small class="text-muted">👤 Posted by: <strong>@item.Author</strong></small>
                    <form asp-controller="Forum" asp-action="Delete" asp-route-id="@item.Id" method="post">
                        <button type="submit" class="btn btn-sm btn-outline-danger">Delete Post</button>
                    </form>
                </div>
            </div>
        }
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-light border mt-3 text-center">No questions asked yet. Start the conversation!</div>
    }
</div>